problem : A - Marathon
link : https://codeforces.com/contest/1692/problem/A
rating : 800
tags : implementation
idea : Since all four distances are distinct, directly compare Timur's distance a with b, c, and d. Count how many values are strictly greater than a (> a) to find how many participants are ahead of him.
Time Complexity: O(1)
Space Complexity: O(1)

program code : --
-----------------------------------------------------------------------------------------------------------------
#include<iostream>
using namespace std;
 
int main(){
    int t;
    cin >> t;
    while(t--){
        int a, b, c, d;
        int count = 0;
        cin >> a >> b >> c >> d;
        if(b > a) count++;
        if(c > a) count++;
        if(d > a) count++;
        cout << count << endl;
    }
    return 0;
}
